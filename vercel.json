{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "*": false, "main": true }
  },
  "services": {
    "server": { "root": "server", "framework": "express" },
    "ui": { "root": "ui", "framework": "create-react-app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/external-api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "ui" } }
  ]
}
