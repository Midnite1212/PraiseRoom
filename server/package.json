{
  "name": "server",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "version": "0.0.0",
  "main": "",
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.18.2",
    "jose": "^5.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:songs": "cross-env TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/import-songs.ts",
    "start": "cross-env NODE_ENV=production nodemon app.ts",
    "dev": "cross-env NODE_ENV=test nodemon app.ts",
    "test": "cross-env TS_NODE_TRANSPILE_ONLY=1 node --test --require ts-node/register 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  }
