{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "main": "",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:songs": "tsx scripts/import-songs.ts",
    "backfill:themes": "tsx scripts/backfill-themes.ts",
    "start": "cross-env NODE_ENV=production tsx app.ts",
    "dev": "cross-env NODE_ENV=test tsx watch app.ts",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.18.2",
    "jose": "^5.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0"
}
