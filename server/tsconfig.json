{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "#/*": ["./src/*"],
      // "node" resolution ignores package exports, so point TypeScript at the ESM-only toolkit types.
      "@neondatabase/auth/server": ["./node_modules/@neondatabase/auth/dist/server/index.d.mts"]
    },
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "app.ts"],
  "exclude": ["node_modules"]
}
